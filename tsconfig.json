{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@goose-hub/core/*": ["./core/*"]
    }
  },
  "include": [
    "core/**/*.ts",
    "apps/cli/**/*.ts",
    "apps/server/**/*.ts",
    "slices/**/*.ts",
    "target-projects/**/*.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "apps/web/**"
  ]
}
