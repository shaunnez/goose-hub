{
  "name": "goose-hub",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "goose": "tsx apps/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "echo 'E2E coming in M2'",
    "install-labels": "tsx scripts/install-labels.ts",
    "db:migrate": "drizzle-kit push --config=drizzle.config.ts",
    "cleanup-worktrees": "bash scripts/cleanup-worktrees.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
