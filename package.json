{
  "name": "goose-hub",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @goose-hub/web --filter @goose-hub/server dev",
    "dev:web": "pnpm --filter @goose-hub/web dev",
    "dev:server": "pnpm --filter @goose-hub/server dev",
    "build": "pnpm --filter @goose-hub/web build",
    "goose": "tsx apps/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @goose-hub/web test:e2e",
    "test:e2e:pipeline": "pnpm --filter @goose-hub/web test:e2e:pipeline",
    "install-labels": "tsx scripts/install-labels.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "cleanup-worktrees": "bash scripts/cleanup-worktrees.sh",
    "backfill:persona-names": "tsx scripts/backfill-persona-names.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@goose-hub/core": "workspace:*",
    "@goose-hub/skills": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
